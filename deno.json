{
  "unstable": [
    "detect-cjs",
    "node-globals",
    "unsafe-proto",
    "sloppy-imports"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:next@16.3.0 dev",
    "build": "deno run -A npm:next@16.3.0 build --webpack",
    "start": "deno run -A npm:next@16.3.0 start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "adaptive:check": "deno check adaptive-service/main.mts",
    "test": "deno test --conditions=react-server --parallel tests",
    "check": "deno task lint && deno task typecheck && deno task adaptive:check && deno task test && deno task build",
    "format": "prettier --write ."
  },
  "deploy": {
    "framework": "nextjs",
    "install": "deno install --allow-scripts",
    "build": "deno task build"
  }
}

# Public variables: add to Build, Production, and Development contexts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_CONTACT_URL=

# Server secrets: add to Production and Development contexts only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ACCESS_SECRET=
ADMIN_PASSWORD=
INTERNAL_API_SECRET=

# Next.js → isolated Deno Adaptive service.
# Leave ADAPTIVE_SERVICE_URL empty to run Adaptive in preview-only mode.
ADAPTIVE_SERVICE_URL=
ADAPTIVE_SERVICE_SECRET=

# Deno Adaptive service only. Do not expose these variables to the browser.
# Use the pooled Neon connection string at runtime.
NEON_DATABASE_URL=

# Optional direct connection for SQL migrations and replay administration.
NEON_DIRECT_URL=
